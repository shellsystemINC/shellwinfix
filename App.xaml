<Application x:Class="TaskbarTYOL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:TaskbarTYOL.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The active theme dictionary is inserted at index 0 at runtime by ThemeManager. -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctl:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ctl:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
