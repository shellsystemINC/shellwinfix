<Window x:Class="TaskbarTYOL.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hidden icons" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{DynamicResource ThemeFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="FlyoutIconButton" TargetType="Button" BasedOn="{StaticResource TrayButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
        </Style>
        <Style x:Key="FlyoutHover" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <!-- AllowDrop on the outer border: dropping a bar icon anywhere on the flyout hides it (demote). -->
    <Border x:Name="Root" Margin="10" Padding="8" Background="{DynamicResource MenuBackground}" BorderBrush="{DynamicResource MenuBorder}"
            BorderThickness="1" CornerRadius="{DynamicResource MenuCornerRadius}" AllowDrop="True"
            DragOver="Root_DragOver" Drop="Root_Drop" MinWidth="150">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.55" Color="{DynamicResource PopupShadow}" />
        </Border.Effect>
        <StackPanel>
            <ItemsControl x:Name="IconList" MaxWidth="230">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FlyoutIconButton}" ToolTip="{Binding DisplayName}" ToolTipService.InitialShowDelay="400"
                                PreviewMouseDown="Icon_MouseDown" PreviewMouseUp="Icon_MouseUp" MouseDoubleClick="Icon_DoubleClick"
                                PreviewMouseMove="Icon_MouseMove" ContextMenuOpening="Icon_ContextMenuOpening">
                            <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="No hidden icons" Margin="6,4" FontSize="12" Visibility="Collapsed"
                       Foreground="{DynamicResource TaskbarForegroundMuted}" />
        </StackPanel>
    </Border>
</Window>
