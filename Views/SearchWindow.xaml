<Window x:Class="TaskbarTYOL.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search" Width="680" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{DynamicResource ThemeFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ContextMenu x:Key="ResultMenu" x:Shared="False">
            <MenuItem Header="Open" Click="Open_Click" />
            <MenuItem Header="Open containing folder" Click="OpenFolder_Click" />
            <MenuItem Header="Copy full path" Click="CopyPath_Click" />
            <MenuItem Header="Run as administrator" Click="RunAdmin_Click" />
        </ContextMenu>
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MenuListBoxItemStyle}">
            <EventSetter Event="MouseLeftButtonUp" Handler="Result_MouseUp" />
            <Setter Property="ContextMenu" Value="{StaticResource ResultMenu}" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="{DynamicResource MenuBackground}" BorderBrush="{DynamicResource MenuBorder}"
            BorderThickness="1" CornerRadius="{DynamicResource MenuCornerRadius}" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.55" Color="{DynamicResource PopupShadow}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBox x:Name="QueryBox" Style="{StaticResource SearchBoxStyle}" FontSize="16" Padding="38,8,10,8"
                         TextChanged="QueryBox_TextChanged" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="16" Margin="13,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TaskbarForegroundMuted}" />
                <TextBlock IsHitTestVisible="False" Text="Search everything on this PC (Everything syntax works: ext:pdf  size:>10mb  dm:today)"
                           Margin="40,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TaskbarForegroundMuted}" Opacity="0.8"
                           Visibility="{Binding Text.IsEmpty, ElementName=QueryBox, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <ListBox x:Name="ResultList" Style="{StaticResource MenuListBoxStyle}" ItemContainerStyle="{StaticResource ResultItemStyle}"
                         KeyDown="ResultList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Foreground="{DynamicResource TaskbarForegroundMuted}" />
                    <Button x:Name="StartEverythingButton" Style="{StaticResource MenuButtonStyle}" Content="Start Everything"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Click="StartEverything_Click" Visibility="Collapsed"
                            Background="{DynamicResource InputBackground}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TaskbarForegroundMuted}"
                           Text="Enter: open   ·   Ctrl+Enter: open folder   ·   Esc: close" />
                <Button Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Right" Click="OpenInEverything_Click" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" Margin="0,0,8,0" />
                        <TextBlock Text="Open in Everything" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
