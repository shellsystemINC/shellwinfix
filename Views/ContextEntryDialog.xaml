<Window x:Class="TaskbarTYOL.Views.ContextEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Right-click menu entry" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource MenuBackground}" Foreground="{DynamicResource MenuForeground}"
        FontFamily="{DynamicResource ThemeFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MenuForeground}" /><Setter Property="Margin" Value="0,10,0,3" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource MenuForeground}" /><Setter Property="Margin" Value="0,0,14,0" /></Style>
        <Style x:Key="Fld" TargetType="TextBox" BasedOn="{StaticResource SearchBoxStyle}"><Setter Property="FontSize" Value="13" /></Style>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" /><Setter Property="Padding" Value="12,6" /><Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Label (what shows in the menu)" />
        <TextBox x:Name="LabelBox" Style="{StaticResource Fld}" />

        <TextBlock Text="Command to run" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox" Style="{StaticResource Fld}" />
            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…" Margin="8,0,0,0" Click="BrowseCommand_Click" />
        </Grid>
        <TextBlock FontSize="11" Foreground="{DynamicResource TaskbarForegroundMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Placeholders: %V = the folder you clicked in (or its background), %1 = the file/folder you clicked. Quote paths that contain spaces." />

        <TextBlock Text="Icon (optional — an .exe, .dll or .ico, e.g. C:\Windows\System32\shell32.dll,3)" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="IconBox" Style="{StaticResource Fld}" />
            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…" Margin="8,0,0,0" Click="BrowseIcon_Click" />
        </Grid>

        <TextBlock Text="Show it on" />
        <WrapPanel>
            <CheckBox x:Name="TgtDesktop" Content="Desktop / background" />
            <CheckBox x:Name="TgtFolder" Content="Folders" />
            <CheckBox x:Name="TgtFile" Content="Files" />
            <CheckBox x:Name="TgtDrive" Content="Drives" />
        </WrapPanel>

        <WrapPanel Margin="0,14,0,0">
            <CheckBox x:Name="TopBox" Content="Pin to top of the menu" />
            <CheckBox x:Name="ShiftBox" Content="Only when Shift is held" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Btn}" Content="Cancel" Click="Cancel_Click" />
            <Button Style="{StaticResource Btn}" Content="OK" Click="Ok_Click" Background="{DynamicResource Accent}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
