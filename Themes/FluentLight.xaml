<!-- Theme: Fluent Light (generated by gen-themes.mjs — edit the script, not this file) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="ThemeName">Fluent Light</sys:String>
    <sys:String x:Key="LogoStyle">Fluent</sys:String>
    <x:Static x:Key="StartText" Member="sys:String.Empty" />
    <FontFamily x:Key="ThemeFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="TaskbarBackground" Color="#F2F3F3F3" />
    <SolidColorBrush x:Key="TaskbarBorder" Color="#20000000" />
    <SolidColorBrush x:Key="TaskbarForeground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TaskbarForegroundMuted" Color="#80000000" />

    <SolidColorBrush x:Key="ButtonHover" Color="#12000000" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#08000000" />
    <SolidColorBrush x:Key="ButtonActive" Color="#1A000000" />
    <SolidColorBrush x:Key="ButtonActiveIndicator" Color="#005FB8" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#00000000" />

    <SolidColorBrush x:Key="StartBackground" Color="#00000000" />
    <SolidColorBrush x:Key="StartHover" Color="#12000000" />
    <SolidColorBrush x:Key="StartForeground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Accent" Color="#005FB8" />

    <SolidColorBrush x:Key="MenuBackground" Color="#F8F9F9F9" />
    <SolidColorBrush x:Key="MenuBorder" Color="#20000000" />
    <SolidColorBrush x:Key="MenuForeground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MenuItemHover" Color="#12000000" />
    <SolidColorBrush x:Key="MenuItemHoverForeground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#30000000" />

    <SolidColorBrush x:Key="LogoBrush1" Color="#0078D4" />
    <SolidColorBrush x:Key="LogoBrush2" Color="#0078D4" />
    <SolidColorBrush x:Key="LogoBrush3" Color="#0078D4" />
    <SolidColorBrush x:Key="LogoBrush4" Color="#0078D4" />
    <Color x:Key="PopupShadow">#80000000</Color>

    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="StartCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="TaskbarCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="MenuCornerRadius">8</CornerRadius>
    <Thickness x:Key="TaskbarBorderThickness">0,1,0,0</Thickness>
    <Thickness x:Key="ButtonBorderThickness">0</Thickness>
    <sys:Double x:Key="ActiveIndicatorHeight">3</sys:Double>
    <sys:Double x:Key="StartButtonMinWidth">48</sys:Double>

