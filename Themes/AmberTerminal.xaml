<!-- Theme: Amber Terminal (generated by gen-themes.mjs — edit the script, not this file) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="ThemeName">Amber Terminal</sys:String>
    <sys:String x:Key="LogoStyle">Fluent</sys:String>
    <sys:String x:Key="StartText">START</sys:String>
    <FontFamily x:Key="ThemeFont">Consolas</FontFamily>

    <SolidColorBrush x:Key="TaskbarBackground" Color="#FA0A0600" />
    <SolidColorBrush x:Key="TaskbarBorder" Color="#FFB000" />
    <SolidColorBrush x:Key="TaskbarForeground" Color="#FFB000" />
    <SolidColorBrush x:Key="TaskbarForegroundMuted" Color="#B37B00" />

    <SolidColorBrush x:Key="ButtonHover" Color="#33FFB000" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#55FFB000" />
    <SolidColorBrush x:Key="ButtonActive" Color="#33FFB000" />
    <SolidColorBrush x:Key="ButtonActiveIndicator" Color="#FFB000" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#60FFB000" />

    <SolidColorBrush x:Key="StartBackground" Color="#00000000" />
    <SolidColorBrush x:Key="StartHover" Color="#33FFB000" />
    <SolidColorBrush x:Key="StartForeground" Color="#FFB000" />
    <SolidColorBrush x:Key="Accent" Color="#FFB000" />

    <SolidColorBrush x:Key="MenuBackground" Color="#FA0A0600" />
    <SolidColorBrush x:Key="MenuBorder" Color="#FFB000" />
    <SolidColorBrush x:Key="MenuForeground" Color="#FFB000" />
    <SolidColorBrush x:Key="MenuItemHover" Color="#33FFB000" />
    <SolidColorBrush x:Key="MenuItemHoverForeground" Color="#FFB000" />
    <SolidColorBrush x:Key="InputBackground" Color="#140C00" />
    <SolidColorBrush x:Key="InputBorder" Color="#FFB000" />

    <SolidColorBrush x:Key="LogoBrush1" Color="#FFB000" />
    <SolidColorBrush x:Key="LogoBrush2" Color="#FFB000" />
    <SolidColorBrush x:Key="LogoBrush3" Color="#FFB000" />
    <SolidColorBrush x:Key="LogoBrush4" Color="#FFB000" />
    <Color x:Key="PopupShadow">#60FFB000</Color>

    <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="StartCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TaskbarCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="MenuCornerRadius">0</CornerRadius>
    <Thickness x:Key="TaskbarBorderThickness">0,1,0,0</Thickness>
    <Thickness x:Key="ButtonBorderThickness">1</Thickness>
    <sys:Double x:Key="ActiveIndicatorHeight">2</sys:Double>
    <sys:Double x:Key="StartButtonMinWidth">80</sys:Double>

</ResourceDictionary>
